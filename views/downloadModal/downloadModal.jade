dialog#downloadModal.appDialog
  .appDialog-header
    button(type='button', aria-label='Close').appDialog-close.dialogClose &#215;
    h4.appDialog-title.disabled Download
  .appDialog-body
    #testStripContent
      include testStripWizard.jade
    #stlContent
      .btn.btn-success.btn-block.disabled#stlDownloadButton.
        Download stl for 3D printer
    #legoContent
      h4.disabled Download instructions
      .btn.btn-success.btn-block.disabled#downloadInstructionsButton.
        Download LEGO instructions and scad file
  .appDialog-footer
    button(type='button').btn.btn-primary.disabled.dialogClose Close
